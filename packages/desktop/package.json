{
  "name": "@kando/desktop",
  "version": "0.10.2",
  "private": true,
  "description": "Kando desktop client",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyhero/kando-agents.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "bundle:backend": "node scripts/bundle-backend.mjs",
    "dist:mac": "electron-vite build && node scripts/bundle-backend.mjs && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@kando/protocol": "workspace:*",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "catalog:",
    "vite": "^7.3.0",
    "zod": "catalog:",
    "zustand": "5.0.15"
  }
}
