{
  "name": "kando",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "dev": "pnpm --parallel --filter @kando/daemon --filter @kando/core --filter @kando/desktop run dev",
    "dev:daemon": "pnpm --filter @kando/daemon run dev",
    "dev:core": "pnpm --filter @kando/core run dev",
    "dev:desktop": "pnpm --filter @kando/desktop run dev",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=${KANDO_HOME:-$HOME/.kando}/browser/ms-playwright pnpm --filter @kando/browser-host exec playwright-core install chromium --no-shell",
    "build": "pnpm --filter @kando/desktop run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "dist:mac": "pnpm --filter @kando/desktop run dist:mac"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
